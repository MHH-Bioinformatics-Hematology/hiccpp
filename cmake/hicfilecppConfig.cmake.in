@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# hicfilecpp links zlib and the thread library privately; a static hicfilecpp
# still needs both at link time, and a shared one finds them through its RPATH.
find_dependency(ZLIB)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/hicfilecppTargets.cmake")
check_required_components(hicfilecpp)
