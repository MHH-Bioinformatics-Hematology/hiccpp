# Doxygen reads the public headers and writes the XML that Breathe turns into
# the API pages. Run it from the repository root: doxygen docs/Doxyfile
PROJECT_NAME           = hiccpp
OUTPUT_DIRECTORY       = docs/_doxygen
INPUT                  = include/hiccpp
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
